APP_NAME="Aula Alfa Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite (padrão, sem instalar nada). Crie o arquivo: touch database/database.sqlite
DB_CONNECTION=sqlite

# Alternativa MySQL (database/docker-compose.yml):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mysqlDB
# DB_USERNAME=root
# DB_PASSWORD=mysqlPW

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
